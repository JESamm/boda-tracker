generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SaccoStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  PLATFORM_ADMIN
  SACCO_ADMIN
  RIDER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum VerificationPurpose {
  LOGIN
  ACTIVATION
  PASSWORD_CHANGE
  EMAIL_VERIFICATION
  EMAIL_LOGIN
}

enum VehicleType {
  MOTORCYCLE
  MATATU
}

enum VehicleStatus {
  ACTIVE
  SUSPENDED
  MAINTENANCE
  RETIRED
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum WorkSessionStatus {
  ACTIVE
  COMPLETED
  INTERRUPTED
}

enum TripStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecordedSource {
  MOBILE
  ADMIN
}

enum ExpenseCategory {
  FUEL
  PARKING
  MAINTENANCE
  OTHER
}

enum LocationSource {
  ANDROID_GPS
  OTHER
}

model Sacco {
  id                 String          @id @default(cuid())
  name               String
  registrationNumber String?         @unique
  phoneNumber        String?
  operatingArea      String?
  status             SaccoStatus     @default(ACTIVE)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  users              User[]
  vehicles           Vehicle[]
  assignments        VehicleAssignment[]
  workSessions       WorkSession[]
  trips              Trip[]
  expenses           Expense[]
  locationUpdates    LocationUpdate[]
  auditLogs          AuditLog[]

  @@index([status, name])
}

model User {
  id                    String              @id @default(cuid())
  fullName              String
  phoneNumber           String              @unique
  email                 String?             @unique
  emailVerifiedAt       DateTime?
  passwordHash          String
  role                  UserRole
  saccoId               String?
  status                UserStatus          @default(ACTIVE)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  sacco                 Sacco?              @relation(fields: [saccoId], references: [id], onDelete: Restrict)
  riderAssignments      VehicleAssignment[] @relation("RiderAssignments")
  actorAssignments      VehicleAssignment[] @relation("AssignmentActor")
  workSessions          WorkSession[]       @relation("SessionRider")
  trips                 Trip[]              @relation("TripRider")
  expenses              Expense[]           @relation("ExpenseRider")
  locationUpdates       LocationUpdate[]    @relation("LocationRider")
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  verificationCodes     VerificationCode[]
  auditLogs             AuditLog[]
  idempotencyRecords    IdempotencyRecord[]

  @@unique([id, saccoId])
  @@index([saccoId, role, status])
  @@index([saccoId, role, deletedAt])
  @@index([fullName])
}

model Vehicle {
  id                     String              @id @default(cuid())
  saccoId                String
  registrationNumber     String
  normalizedRegistration String
  type                   VehicleType
  status                 VehicleStatus       @default(ACTIVE)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  sacco                  Sacco               @relation(fields: [saccoId], references: [id], onDelete: Restrict)
  assignments            VehicleAssignment[]
  workSessions           WorkSession[]
  trips                  Trip[]
  locationUpdates        LocationUpdate[]

  @@unique([saccoId, normalizedRegistration])
  @@unique([id, saccoId])
  @@index([saccoId, type, status])
}

model VehicleAssignment {
  id           String           @id @default(cuid())
  saccoId      String
  vehicleId    String
  riderId      String
  assignedById String
  assignedAt   DateTime         @default(now())
  unassignedAt DateTime?
  status       AssignmentStatus @default(ACTIVE)
  sacco        Sacco            @relation(fields: [saccoId], references: [id], onDelete: Restrict)
  vehicle      Vehicle          @relation(fields: [vehicleId, saccoId], references: [id, saccoId], onDelete: Restrict)
  rider        User             @relation("RiderAssignments", fields: [riderId, saccoId], references: [id, saccoId], onDelete: Restrict)
  assignedBy   User             @relation("AssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)
  workSessions WorkSession[]

  @@unique([id, saccoId, riderId, vehicleId])
  @@index([saccoId, status, assignedAt])
  @@index([riderId, saccoId, status])
  @@index([vehicleId, saccoId, status])
}

model WorkSession {
  id               String            @id @default(cuid())
  saccoId          String
  riderId          String
  vehicleId        String
  assignmentId     String
  startedAt        DateTime          @default(now())
  endedAt          DateTime?
  startLatitude    Decimal?          @db.Decimal(9, 6)
  startLongitude   Decimal?          @db.Decimal(9, 6)
  endLatitude      Decimal?          @db.Decimal(9, 6)
  endLongitude     Decimal?          @db.Decimal(9, 6)
  status           WorkSessionStatus @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sacco            Sacco             @relation(fields: [saccoId], references: [id], onDelete: Restrict)
  rider            User              @relation("SessionRider", fields: [riderId, saccoId], references: [id, saccoId], onDelete: Restrict)
  vehicle          Vehicle           @relation(fields: [vehicleId, saccoId], references: [id, saccoId], onDelete: Restrict)
  assignment       VehicleAssignment @relation(fields: [assignmentId, saccoId, riderId, vehicleId], references: [id, saccoId, riderId, vehicleId], onDelete: Restrict)
  trips            Trip[]
  expenses         Expense[]
  locationUpdates  LocationUpdate[]

  @@unique([id, saccoId])
  @@unique([id, saccoId, riderId])
  @@unique([id, saccoId, riderId, vehicleId])
  @@index([saccoId, status, startedAt])
  @@index([riderId, saccoId, status])
  @@index([vehicleId, saccoId, status])
}

model Trip {
  id              String         @id @default(cuid())
  saccoId         String
  riderId         String
  vehicleId       String
  workSessionId   String
  startedAt       DateTime       @default(now())
  endedAt         DateTime?
  startLatitude   Decimal?       @db.Decimal(9, 6)
  startLongitude  Decimal?       @db.Decimal(9, 6)
  endLatitude     Decimal?       @db.Decimal(9, 6)
  endLongitude    Decimal?       @db.Decimal(9, 6)
  distanceKm      Decimal?       @db.Decimal(10, 2)
  fareAmount      Decimal?       @db.Decimal(12, 2)
  status          TripStatus     @default(IN_PROGRESS)
  recordedSource  RecordedSource @default(MOBILE)
  idempotencyKey  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sacco           Sacco          @relation(fields: [saccoId], references: [id], onDelete: Restrict)
  rider           User           @relation("TripRider", fields: [riderId, saccoId], references: [id, saccoId], onDelete: Restrict)
  vehicle         Vehicle        @relation(fields: [vehicleId, saccoId], references: [id, saccoId], onDelete: Restrict)
  workSession     WorkSession    @relation(fields: [workSessionId, saccoId, riderId, vehicleId], references: [id, saccoId, riderId, vehicleId], onDelete: Restrict)

  @@unique([riderId, idempotencyKey])
  @@index([saccoId, startedAt, status])
  @@index([riderId, saccoId, startedAt])
  @@index([vehicleId, saccoId, startedAt])
  @@index([workSessionId, saccoId, status])
}

model Expense {
  id            String          @id @default(cuid())
  saccoId       String
  riderId       String
  workSessionId String?
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(12, 2)
  description   String?
  recordedAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sacco         Sacco           @relation(fields: [saccoId], references: [id], onDelete: Restrict)
  rider         User            @relation("ExpenseRider", fields: [riderId, saccoId], references: [id, saccoId], onDelete: Restrict)
  workSession   WorkSession?    @relation(fields: [workSessionId, saccoId, riderId], references: [id, saccoId, riderId], onDelete: Restrict)

  @@index([saccoId, recordedAt, category])
  @@index([riderId, saccoId, recordedAt])
  @@index([workSessionId, saccoId])
}

model LocationUpdate {
  id              String         @id @default(cuid())
  saccoId         String
  riderId         String
  vehicleId       String
  workSessionId   String?
  latitude        Decimal        @db.Decimal(9, 6)
  longitude       Decimal        @db.Decimal(9, 6)
  accuracyMeters  Decimal?       @db.Decimal(8, 2)
  recordedAt      DateTime
  receivedAt      DateTime       @default(now())
  source          LocationSource @default(ANDROID_GPS)
  idempotencyKey  String
  sacco           Sacco          @relation(fields: [saccoId], references: [id], onDelete: Restrict)
  rider           User           @relation("LocationRider", fields: [riderId, saccoId], references: [id, saccoId], onDelete: Restrict)
  vehicle         Vehicle        @relation(fields: [vehicleId, saccoId], references: [id, saccoId], onDelete: Restrict)
  workSession     WorkSession?   @relation(fields: [workSessionId, saccoId, riderId, vehicleId], references: [id, saccoId, riderId, vehicleId], onDelete: Restrict)

  @@unique([riderId, idempotencyKey])
  @@index([saccoId, vehicleId, recordedAt(sort: Desc)])
  @@index([saccoId, riderId, recordedAt(sort: Desc)])
  @@index([workSessionId, recordedAt(sort: Desc)])
}

model AuditLog {
  id          String   @id @default(cuid())
  saccoId     String?
  actorUserId String
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  sacco       Sacco?   @relation(fields: [saccoId], references: [id], onDelete: Restrict)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([saccoId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model VerificationCode {
  id          String             @id @default(cuid())
  userId      String
  purpose     VerificationPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int                @default(0)
  consumedAt  DateTime?
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  userId         String
  key            String
  operation      String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}
