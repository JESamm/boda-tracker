APP_ENV=development
PORT=3001
DATABASE_URL=postgresql://boda_tracker:local_dev_only@localhost:5432/boda_tracker?schema=public
# Optional: direct or session-pooler URL used only for Prisma migrations.
# MIGRATION_DATABASE_URL=
AUTH_ACCESS_TOKEN_SECRET=replace_with_a_random_secret_of_at_least_32_characters
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Live SMS requires Africa's Talking credentials and an approved Sender ID.
# Default sandbox sender IDs do not deliver to Safaricom.
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=
# Brevo transactional email; verify the sender address in Brevo before use.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Boda-Tracker
